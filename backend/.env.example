# Google Drive API key. Sent only in the X-Goog-Api-Key header. Placeholder only.
GOOGLE_API_KEY=your_google_api_key_here

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Path to the tesseract executable. Leave empty to use the system PATH.
# On Windows, set this when Tesseract is not on PATH, for example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Path to the tessdata directory. Leave empty to use the Tesseract default.
# On Windows this is often:
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
TESSDATA_PREFIX=

# Tesseract language codes, joined with +.
DEFAULT_OCR_LANGUAGE=fra+eng

# Reject a single file larger than this size.
MAX_FILE_SIZE_MB=25

# Maximum files accepted in one batch.
MAX_FILES_PER_BATCH=50

# Maximum files returned when listing a Drive folder.
MAX_LISTED_FILES=500

# Stop extraction after this many PDF pages.
MAX_PDF_PAGES=30

# Reject images whose width times height exceeds this pixel count.
MAX_IMAGE_PIXELS=50000000

# Wall-clock budget, in seconds, for processing one file.
FILE_TIME_BUDGET_S=120

# Timeout, in seconds, for OCR of a single page.
OCR_PAGE_TIMEOUT_S=60

# A page with fewer extracted characters is sent to OCR.
MIN_PAGE_CHARS=25

# Rasterization DPI used before OCR.
OCR_RENDER_DPI=200

# Concurrent workers inside one batch.
BATCH_WORKERS=2

# Maximum number of batches allowed in queued or running state at the same time.
MAX_ACTIVE_BATCHES=4

# How long a finished batch is kept in memory, in minutes.
BATCH_TTL_MINUTES=60

# Python logging level.
LOG_LEVEL=INFO
